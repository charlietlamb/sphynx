{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    // shadcn/ui primitives are vendored, not hand-authored app code.
    "includes": ["!packages/ui/src/components/ui", "!.agents", "!context"]
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      // These render GitHub's own sanitized bodyHTML, the same HTML github.com
      // serves — the only sanctioned innerHTML sinks.
      "includes": [
        "apps/web/src/components/dashboard/dossier-description.tsx",
        "apps/web/src/components/pull-request/conversation-body.tsx"
      ],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      // TanStack Start file-based routes use reserved filenames ($ splat,
      // __root, etc.) that aren't kebab-case by design.
      "includes": ["apps/web/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      // Convex resolves functions by module path and rejects filenames with
      // hyphens (only alphanumerics, underscores, periods), so its modules are
      // camelCase by requirement. Only the filename rule is relaxed here; every
      // other lint stays enforced on these files.
      "includes": ["packages/backend/convex/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
