{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "ignoreCommand": "npx turbo-ignore @sphynx/web",
      "headers": [
        {
          "source": "/assets/(.*)",
          "headers": [
            {
              "key": "cache-control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }]
}
