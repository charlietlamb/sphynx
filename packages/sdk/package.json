{
  "name": "sphynx-sh",
  "version": "0.1.32",
  "description": "TypeScript SDK and CLI for coding agent evals and prompt management.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./api": {
      "import": {
        "types": "./dist/api.d.mts",
        "default": "./dist/api.mjs"
      },
      "require": {
        "types": "./dist/api.d.cts",
        "default": "./dist/api.cjs"
      }
    },
    "./api/runtime": {
      "import": {
        "types": "./dist/api-runtime.d.mts",
        "default": "./dist/api-runtime.mjs"
      },
      "require": {
        "types": "./dist/api-runtime.d.cts",
        "default": "./dist/api-runtime.cjs"
      }
    },
    "./validators": {
      "import": {
        "types": "./dist/validators.d.mts",
        "default": "./dist/validators.mjs"
      },
      "require": {
        "types": "./dist/validators.d.cts",
        "default": "./dist/validators.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.mts",
        "default": "./dist/cli.mjs"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    },
    "./cli/runtime": {
      "import": {
        "types": "./dist/cli-runtime.d.mts",
        "default": "./dist/cli-runtime.mjs"
      },
      "require": {
        "types": "./dist/cli-runtime.d.cts",
        "default": "./dist/cli-runtime.cjs"
      }
    },
    "./eval": {
      "import": {
        "types": "./dist/eval.d.mts",
        "default": "./dist/eval.mjs"
      },
      "require": {
        "types": "./dist/eval.d.cts",
        "default": "./dist/eval.cjs"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/mcp.d.mts",
        "default": "./dist/mcp.mjs"
      },
      "require": {
        "types": "./dist/mcp.d.cts",
        "default": "./dist/mcp.cjs"
      }
    },
    "./runner": {
      "import": {
        "types": "./dist/runner.d.mts",
        "default": "./dist/runner.mjs"
      },
      "require": {
        "types": "./dist/runner.d.cts",
        "default": "./dist/runner.cjs"
      }
    },
    "./runner/eve": {
      "import": {
        "types": "./dist/runner-eve.d.mts",
        "default": "./dist/runner-eve.mjs"
      },
      "require": {
        "types": "./dist/runner-eve.d.cts",
        "default": "./dist/runner-eve.cjs"
      }
    },
    "./mcp/runtime": {
      "import": {
        "types": "./dist/mcp-runtime.d.mts",
        "default": "./dist/mcp-runtime.mjs"
      },
      "require": {
        "types": "./dist/mcp-runtime.d.cts",
        "default": "./dist/mcp-runtime.cjs"
      }
    }
  },
  "keywords": [
    "sphynx",
    "evals",
    "agents",
    "sandboxes",
    "prompts",
    "prompt-management",
    "versioning",
    "ai",
    "llm",
    "sdk",
    "cli"
  ],
  "homepage": "https://sphynx.sh",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests",
    "lint:publish": "publint --strict",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@sphynx/eval": "workspace:*",
    "@sphynx/schema": "workspace:*",
    "@sphynx/template": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "eve": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "@effect/cli": "^0.75.2",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.107.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@standard-schema/spec": "^1.1.0",
    "@trigger.dev/sdk": "^4.5.15",
    "effect": "^3.21.2",
    "esbuild": "^0.25.12",
    "ignore": "^7.0.8",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "eve": "^0.58.1"
  },
  "peerDependenciesMeta": {
    "eve": {
      "optional": true
    }
  },
  "bin": {
    "sphynx": "./dist/bin.mjs",
    "sphynx-eve": "./dist/runner-eve-bin.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlietlamb/sphynx.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/charlietlamb/sphynx/issues"
  }
}
